#<src>                                 <mnt_point>        <type>   <fs_mgr_flags>
# ===============================
# Core Partitions
# ===============================
system                                 /system_root        ext4    ro wait,slotselect,avb=vbmeta_system,logical,first_stage_mount,avb_keys=/avb/q-gsi.avbpubkey:/avb/r-gsi.avbpubkey:/avb/s-gsi.avbpubkey
system                                 /system_root        erofs   ro wait,slotselect,avb=vbmeta_system,logical,first_stage_mount,avb_keys=/avb/q-gsi.avbpubkey:/avb/r-gsi.avbpubkey:/avb/s-gsi.avbpubkey
vendor                                 /vendor             ext4    ro wait,slotselect,avb,logical,first_stage_mount
vendor                                 /vendor             erofs   ro wait,slotselect,avb,logical,first_stage_mount
vendor_dlkm                            /vendor_dlkm        ext4    ro wait,slotselect,avb,logical,first_stage_mount
vendor_dlkm                            /vendor_dlkm        erofs   ro wait,slotselect,avb,logical,first_stage_mount
product                                /product            ext4    ro wait,slotselect,avb,logical,first_stage_mount
product                                /product            erofs   ro wait,slotselect,avb,logical,first_stage_mount
system_ext                             /system_ext         ext4    ro wait,slotselect,avb,logical,first_stage_mount
system_ext                             /system_ext         erofs   ro wait,slotselect,avb,logical,first_stage_mount
odm                                    /odm                ext4    ro wait,logical,slotselect,first_stage_mount,nofail
odm                                    /odm                erofs   ro wait,logical,slotselect,first_stage_mount,nofail
odm_dlkm                               /odm_dlkm           ext4    ro wait,slotselect,logical,first_stage_mount,nofail
odm_dlkm                               /odm_dlkm           erofs   ro wait,slotselect,logical,first_stage_mount,nofail

# ===============================
# Core Partitions
# ===============================
/dev/block/by-name/boot                /boot               emmc
/dev/block/by-name/dtbo                /dtbo               emmc
/dev/block/by-name/super               /super              emmc
/dev/block/by-name/vendor_boot         /vendor_boot        emmc
/dev/block/by-name/vbmeta              /vbmeta             emmc
/dev/block/by-name/vbmeta_system       /vbmeta_system      emmc
/dev/block/by-name/vbmeta_vendor       /vbmeta_vendor      emmc

# ===============================
# Userdata Partitions
# ===============================
/dev/block/by-name/userdata            /data               f2fs     flags=fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized;keydirectory=/metadata/vold/metadata_encryption;quota

# ===============================
# External
# ===============================
/dev/block/mmcblk0p1                   /external_sd        vfat
/dev/block/sdd1                        /usb_otg            vfat
