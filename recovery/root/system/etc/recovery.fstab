# ===============================
# Boot images
# ===============================
/boot                emmc   /dev/block/by-name/boot_a
/boot                emmc   /dev/block/by-name/boot_b
/dtbo                emmc   /dev/block/by-name/dtbo_a
/dtbo                emmc   /dev/block/by-name/dtbo_b
/vendor_boot         emmc   /dev/block/by-name/vendor_boot_a
/vendor_boot         emmc   /dev/block/by-name/vendor_boot_b
/vbmeta              emmc   /dev/block/by-name/vbmeta_a
/vbmeta              emmc   /dev/block/by-name/vbmeta_b
/vbmeta_system       emmc   /dev/block/by-name/vbmeta_a
/vbmeta_system       emmc   /dev/block/by-name/vbmeta_a
/vbmeta_vendor       emmc   /dev/block/by-name/vbmeta_a
/vbmeta_vendor       emmc   /dev/block/by-name/vbmeta_a

# ===============================
# Metadata
# ===============================
/metadata            ext4   /dev/block/by-name/metadata

# ===============================
# Data (FBE + INLINECRYPT)
# ===============================
/data                f2fs   /dev/block/by-name/userdata flags=encryptable=footer;fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized;keydirectory=/metadata/vold/metadata_encryption

# ===============================
# External
# ===============================
/external_sd         vfat  /dev/block/mmcblk0p1
/usb_otg             vfat  /dev/block/sdd1
