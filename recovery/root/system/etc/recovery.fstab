#<src>                                 <mnt_point>         <type>     <mnt_flags>                                                                                                    <fs_mgr_flags>
# ===============================
# Dynamic Partitions
# ===============================
system                                 /system             ext4       ro
system                                 /system             erofs      ro
system_ext                             /system_ext         ext4       ro
system_ext                             /system_ext         erofs      ro
vendor                                 /vendor             ext4       ro
vendor                                 /vendor             erofs      ro
product                                /product            ext4       ro
product                                /product            erofs      ro
odm                                    /odm                ext4       ro
odm                                    /odm                erofs      ro
odm_dlkm                               /odm_dlkm           ext4       ro
vendor_dlkm                            /vendor_dlkm        ext4       ro

# ===============================
# Core Partitions
# ===============================
/dev/block/by-name/boot                /boot               emmc       defaults
/dev/block/by-name/dtbo                /dtbo               emmc       defaults
/dev/block/by-name/vendor_boot         /vendor_boot        emmc       defaults
/dev/block/by-name/vbmeta              /vbmeta             emmc       defaults
/dev/block/by-name/vbmeta_system       /vbmeta_system      emmc       defaults
/dev/block/by-name/vbmeta_vendor       /vbmeta_vendor      emmc       defaults

# ===============================
# User Data Partitions
# ===============================
/dev/block/by-name/metadata            /metadata           ext4
/dev/block/by-name/userdata            /data               f2fs
# ===============================
# External
# ===============================
/dev/block/mmcblk0p1                   /external_sd        vfat
/dev/block/sdd1                        /usb_otg            vfat
