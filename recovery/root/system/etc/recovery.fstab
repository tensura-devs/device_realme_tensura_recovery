# ===============================
# Dynamic Partitions (logical)
# ===============================
system                                 /system_root         erofs    ro wait,logical,slotselect
vendor                                 /vendor              erofs    ro wait,logical,slotselect
vendor_dlkm                            /vendor_dlkm         ext4     ro wait,logical,slotselect
product                                /product             ext4     ro wait,logical,slotselect
system_ext                             /system_ext          erofs    ro wait,logical,slotselect
odm                                    /odm                 erofs    ro wait,logical,slotselect
odm_dlkm                               /odm_dlkm            ext4     ro wait,logical,slotselect
my_product                             /my_product          erofs    ro wait,slotselect,logical
my_engineering                         /my_engineering      erofs    ro wait,slotselect,logical
my_company                             /my_company          erofs    ro wait,slotselect,logical
my_carrier                             /my_carrier          erofs    ro wait,slotselect,logical
my_region                              /my_region           erofs    ro wait,slotselect,logical
my_heytap                              /my_heytap           erofs    ro wait,slotselect,logical
my_stock                               /my_stock            erofs    ro wait,slotselect,logical
my_preload                             /my_preload          erofs    ro wait,slotselect,logical
my_bigball                             /my_bigball          erofs    ro wait,slotselect,logical
my_manifest                            /my_manifest         erofs    ro wait,slotselect,logical

# ===============================
# Raw Partitions
# ===============================
/dev/block/by-name/boot                /boot                emmc
/dev/block/by-name/dtbo                /dtbo                emmc
/dev/block/by-name/super               /super               emmc
/dev/block/by-name/vendor_boot         /vendor_boot         emmc
/dev/block/by-name/vbmeta              /vbmeta              emmc
/dev/block/by-name/vbmeta_system       /vbmeta_system       emmc
/dev/block/by-name/vbmeta_vendor       /vbmeta_vendor       emmc

# ===============================
# Metadata (WAJIB untuk FBE decrypt)
# ===============================
/dev/block/by-name/metadata            /metadata            ext4    noatime,nosuid,nodev,discard     display="Metadata",wait,check,formattable
# ===============================
# Userdata
# ===============================
/dev/block/by-name/userdata            /data                f2fs    noatime,nosuid,nodev,discard,noflush_merge,fsync_mode=nobarrier,reserve_root=134217,resgid=1065,inlinecrypt wait,check,formattable,quota,resize,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption

# ===============================
# Core
# ===============================
/dev/block/by-name/persist             /persist             ext4    noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,formattable

# ===============================
# External
# ===============================
/dev/block/mmcblk0p1                   /external_sd         vfat    nosuid,nodev defaults
/dev/block/sdd1                        /usb_otg             vfat    nosuid,nodev defaults
