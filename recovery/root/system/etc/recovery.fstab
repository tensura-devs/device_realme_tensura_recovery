# ===============================
# Boot images
# ===============================
/boot         emmc   /dev/block/by-name/boot
/dtbo         emmc   /dev/block/by-name/dtbo
/vendor_boot  emmc   /dev/block/by-name/vendor_boot
/vbmeta       emmc   /dev/block/by-name/vbmeta

# ===============================
# Metadata (WAJIB untuk FBE)
# ===============================
/metadata     ext4   /dev/block/by-name/metadata

# ===============================
# Data (FBE + INLINECRYPT)
# ===============================
/data         f2fs   /dev/block/by-name/userdata flags=encryptable=footer;fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized;keydirectory=/metadata/vold/metadata_encryption

# ===============================
# Dynamic partitions (IMAGE ONLY)
# ===============================
system       ext4   /dev/block/mapper/system
system       erofs  /dev/block/mapper/system
system_ext   ext4   /dev/block/mapper/system_ext
system_ext   erofs  /dev/block/mapper/system_ext
vendor       ext4   /dev/block/mapper/vendor
vendor       erofs  /dev/block/mapper/vendor
vendor_dlkm  ext4   /dev/block/mapper/vendor_dlkm
vendor_dlkm  erofs  /dev/block/mapper/vendor_dlkm
product      ext4   /dev/block/mapper/product
product      erofs  /dev/block/mapper/product
odm          ext4   /dev/block/mapper/odm
odm          erofs  /dev/block/mapper/odm
odm_dlkm_    ext4   /dev/block/mapper/odm_dlkm
odm_dlkm_    erofs  /dev/block/mapper/odm_dlkm

# ===============================
# External
# ===============================
/external_sd  vfat  /dev/block/mmcblk0p1
/usb_otg      vfat  /dev/block/sdd1
