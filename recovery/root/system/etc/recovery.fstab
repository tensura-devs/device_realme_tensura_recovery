# ===============================
# Dynamic Partitions (logical)
# ===============================
vendor                                 /vendor              erofs    ro wait,slotselect,avb,logical,first_stage_mount
odm                                    /odm                 erofs    ro wait,logical,slotselect,first_stage_mount,nofail
system                                 /system_root         erofs    ro slotselect
vendor_dlkm                            /vendor_dlkm         ext4     ro
product                                /product             ext4     ro
system_ext                             /system_ext          erofs    ro
odm_dlkm                               /odm_dlkm            ext4     ro

# ===============================
# Raw Partitions
# ===============================
/dev/block/by-name/boot                /boot                emmc
/dev/block/by-name/dtbo                /dtbo                emmc
/dev/block/by-name/super               /super               emmc
/dev/block/by-name/vendor_boot         /vendor_boot         emmc
/dev/block/by-name/vbmeta              /vbmeta              emmc
/dev/block/by-name/vbmeta_system       /vbmeta_system       emmc
/dev/block/by-name/vbmeta_vendor       /vbmeta_vendor       emmc

# ===============================
# Metadata (WAJIB untuk FBE decrypt)
# ===============================
/dev/block/by-name/metadata            /metadata            ext4    defaults                         display="Metadata"

# ===============================
# Userdata
# ===============================
/dev/block/by-name/userdata            /data                f2fs     noatime,nosuid,nodev,discard    fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,wrappedkey

# ===============================
# External
# ===============================
/dev/block/mmcblk0p1                   /external_sd         vfat
/dev/block/sdd1                        /usb_otg             vfat
