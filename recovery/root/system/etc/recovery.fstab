#<src>                                 <mnt_point>        <type>                                                                                                 <fs_mgr_flags>
# ===============================
# Dynamic Partitions
# ===============================
system                                 /system             ext4
system                                 /system             erofs
system_ext                             /system_ext         ext4
system_ext                             /system_ext         erofs
vendor                                 /vendor             ext4
vendor                                 /vendor             erofs
product                                /product            ext4
product                                /product            erofs
odm                                    /odm                ext4
odm                                    /odm                erofs
odm_dlkm                               /odm_dlkm           ext4
vendor_dlkm                            /vendor_dlkm        ext4

# ===============================
# Core Partitions
# ===============================
/dev/block/by-name/boot                /boot               emmc
/dev/block/by-name/dtbo                /dtbo               emmc
/dev/block/by-name/vendor_boot         /vendor_boot        emmc
/dev/block/by-name/vbmeta              /vbmeta             emmc
/dev/block/by-name/vbmeta_system       /vbmeta_system      emmc
/dev/block/by-name/vbmeta_vendor       /vbmeta_vendor      emmc

# ===============================
# User Data Partitions
# ===============================
/dev/block/by-name/metadata            /metadata           ext4
/dev/block/by-name/userdata            /data               f2fs
# ===============================
# External
# ===============================
/dev/block/mmcblk0p1                   /external_sd        vfat
/dev/block/sdd1                        /usb_otg            vfat
