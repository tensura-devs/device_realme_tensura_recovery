#<src>                    <type> <mnt_point>                                     <flags>

#User Data Partitions
/metadata                 ext4   /dev/block/by-name/metadata                     flags=display="Metadata"
/data                     f2fs   /dev/block/by-name/userdata                     flags=fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,wrappedkey
/persistent               emmc   /dev/block/by-name/frp                          flags=display="persistent"

# Core Partitions
/boot                     emmc   /dev/block/by-name/boot                         flags=backup=1;display="boot";slotselect;flashimg=1
/dtbo                     emmc   /dev/block/by-name/dtbo                         flags=backup=1;display="dtbo";slotselect;flashimg=1
/vendor_boot              emmc   /dev/block/by-name/vendor_boot                  flags=backup=1;display="vendor_boot";slotselect;flashimg=1
/vbmeta                   emmc   /dev/block/by-name/vbmeta                       flags=backup=1;display="vbmeta";slotselect;flashimg=1
/vbmeta_system            emmc   /dev/block/by-name/vbmeta_system                flags=backup=1;display="vbmeta_system";slotselect;flashimg=1
/vbmeta_vendor            emmc   /dev/block/by-name/vbmeta_vendor                flags=backup=1;display="vbmeta_vendor";slotselect;flashimg=1

# Dynamic Partitions
/system_root              emmc   /dev/block/mapper/system                        flags=backup=1;display="system";slotselect;flashimg=1
/system_ext               emmc   /dev/block/mapper/system_ext                    flags=backup=1;display="system_ext";slotselect;flashimg=1
/vendor                   emmc   /dev/block/mapper/vendor                        flags=backup=1;display="vendor";slotselect;flashimg=1
/vendor_dlkm              emmc   /dev/block/mapper/vendor_dlkm                   flags=backup=1;display="vendor_dlkm";slotselect;flashimg=1
/product                  emmc   /dev/block/mapper/product                       flags=backup=1;display="product";slotselect;flashimg=1
/odm                      emmc   /dev/block/mapper/odm                           flags=backup=1;display="odm";slotselect;flashimg=1
/odm_dlkm                 emmc   /dev/block/mapper/odm_dlkm                      flags=backup=1;display="odm_dlkm";slotselect;flashimg=1

#IMEI
/nvram                    emmc   /dev/block/by-name/nvram                        flags=backup;display="IMEI"
/boot_para                emmc   /dev/block/by-name/boot_para                    flags=backup;subpartitionof=/nvram
/nvcfg                    ext4   /dev/block/by-name/nvcfg                        flags=backup;subpartitionof=/nvram
/nvdata                   ext4   /dev/block/by-name/nvdata                       flags=backup;subpartitionof=/nvram
/bootloader2              emmc   /dev/block/by-name/bootloader2                  flags=backup;subpartitionof=/nvram
/proinfo                  emmc   /dev/block/by-name/proinfo                      flags=backup;subpartitionof=/nvram
/persist                  ext4   /dev/block/by-name/persist                      flags=display="persist";backup=0;removable
/mnt/vendor/protect_f     emmc   /dev/block/by-name/protect1                     flags=backup;subpartitionof=/nvram
/mnt/vendor/protect_s     emmc   /dev/block/by-name/protect2                     flags=backup;subpartitionof=/nvram
/seccfg                   emmc   /dev/block/by-name/seccfg                       flags=display="seccfg"

# Removable Storage
/external_sd              auto   /dev/block/mmcblk1p1 /dev/block/mmcblk0p1       flags=display="External_SDcard";storage;wipeingui;removable
/usb_otg                  auto   /dev/block/sdd1                                 flags=removable;storage;nofail
