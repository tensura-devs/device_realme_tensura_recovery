#<src>              <type> <mnt_point>                                     <flags>

# Dynamic Partitions
/system_image       ext4   /dev/block/mapper/system                        flags=backup=1;display="System Image";slotselect;flashimg=1
/system_image       erofs  /dev/block/mapper/system                        flags=backup=1;display="System Image";slotselect;flashimg=1
/system_ext_image   ext4   /dev/block/mapper/system_ext                    flags=backup=1;display="System_ext Image";slotselect;flashimg=1
/system_ext_image   erofs  /dev/block/mapper/system_ext                    flags=backup=1;display="System_ext Image";slotselect;flashimg=1
/vendor_image       ext4   /dev/block/mapper/vendor                        flags=backup=1;display="Vendor Image";slotselect;flashimg=1
/vendor_image       erofs  /dev/block/mapper/vendor                        flags=backup=1;display="Vendor Image";slotselect;flashimg=1
/vendor_dlkm_image  ext4   /dev/block/mapper/vendor_dlkm                   flags=backup=1;display="VendorDLKM Image";slotselect;flashimg=1
/vendor_dlkm_image  erofs  /dev/block/mapper/vendor_dlkm                   flags=backup=1;display="VendorDLKM Image";slotselect;flashimg=1
/product_image      ext4   /dev/block/mapper/product                       flags=backup=1;display="Product Image";slotselect;flashimg=1
/product_image      erofs  /dev/block/mapper/product                       flags=backup=1;display="Product Image";slotselect;flashimg=1
/odm                ext4   /dev/block/mapper/odm                           flags=backup=1;display="Odm Image";slotselect;flashimg=1
/odm                erofs  /dev/block/mapper/odm                           flags=backup=1;display="Odm Image";slotselect;flashimg=1
/odm_dlkm_image     ext4   /dev/block/mapper/odm_dlkm                      flags=backup=1;display="OdmDLKM Image";slotselect;flashimg=1
/odm_dlkm_image     erofs  /dev/block/mapper/odm_dlkm                      flags=backup=1;display="OdmDLKM Image";slotselect;flashimg=1

# Super partition
/super              emmc   /dev/block/by-name/super                        flags=backup=1;display="Super Image";flashimg=1

# Removable Storage
/external_sd        auto   /dev/block/mmcblk1p1 /dev/block/mmcblk0p1       flags=display="External_SDcard";storage;wipeingui;removable
/usb_otg            auto   /dev/block/sda1 /dev/block/sda /dev/block/sdd1  flags=storage;wipeingui;removable

#IMEI
/nvram_image        emmc   /dev/block/by-name/nvram                        flags=backup;display="IMEI"
/nvdata             ext4   /dev/block/by-name/nvdata                       flags=backup;subpartitionof=/nvram_image
/nvcfg              ext4   /dev/block/by-name/nvcfg                        flags=backup;subpartitionof=/nvram_image
/persist_image      emmc   /dev/block/by-name/persist                      flags=backup;subpartitionof=/nvram_image
/protect1_image     emmc   /dev/block/by-name/protect1                     flags=backup;subpartitionof=/nvram_image
/protect2_image     emmc   /dev/block/by-name/protect2                     flags=backup;subpartitionof=/nvram_image
/proinfo_image      emmc   /dev/block/by-name/proinfo                      flags=backup;subpartitionof=/nvram_image
/seccfg_image       emmc   /dev/block/by-name/seccfg                       flags=backup;subpartitionof=/nvram_image
/nvram              auto   /dev/block/by-name/nvram                        flags=display="Nvram"
/persist            ext4   /dev/block/by-name/persist                      flags=display="Persist"
/proinfo            auto   /dev/block/by-name/proinfo                      flags=display="Proinfo"
/seccfg             auto   /dev/block/by-name/seccfg
