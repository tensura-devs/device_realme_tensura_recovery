import /init.recovery.logd.rc
import /trustonic.rc
import /tee.rc

on early-init
    # Set security contexts
    setcon u:r:recovery:s0
    start ueventd
    start healthd

    # FIX #1: Set USB properties lebih awal untuk mencegah ADB restart loop
    setprop service.adb.root 1
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "musb-hdrc"
    setprop sys.usb.ffs.aio_compat 1

on init
    write /proc/touchpanel/tp_fw_update 1
    start tp_fw_flash

    # Set CPU governor to performance to fix touch lag
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor "performance"
    write /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor "performance"
    write /sys/devices/system/cpu/cpu6/cpufreq/scaling_governor "performance"

    export ANDROID_ROOT /system
    export ANDROID_DATA /data
    export EXTERNAL_STORAGE /sdcard
    # FIX: Tambah /vendor/lib64/hw agar impl .so bisa ditemukan saat dlopen
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw

    mkdir /boot
    mkdir /recovery
    mkdir /system 0771 root root
    mkdir /vendor 0755 root root
    mkdir /data
    mkdir /metadata
    mkdir /cache

    mkdir /mnt 0755 root root
    mkdir /mnt/vendor 0755 root root
    mkdir /mnt/vendor/persist 0771 root root
    mkdir /mnt/vendor/protect_f 0771 root root
    mkdir /mnt/vendor/protect_s 0771 root root

    mkdir /nvdata 0771 root root
    mkdir /nvcfg 0771 root root

    symlink /system/bin /bin
    symlink /system/etc /etc

    mkdir /dev/block
    mkdir /dev/block/platform
    mkdir /dev/block/by-name

    chmod 0666 /dev/null
    chmod 0666 /dev/kmsg

    # FIX #2: Mount persist LEBIH AWAL di init (sebelum mobicore)
    wait /dev/block/by-name/persist
    mount ext4 /dev/block/by-name/persist /persist rw
    chown system system /persist
    chmod 0771 /persist
    restorecon /persist

    # Create mcRegistry untuk Trustonic
    mkdir /persist/mcRegistry 0771 root root
    chmod 0771 /persist/mcRegistry
    symlink /persist/mcRegistry /mnt/vendor/persist/mcRegistry

    setprop crypto.ready 1

on fs
    symlink /dev/block/platform/bootdevice /dev/block/bootdevice

    # Setup logical partition device mapper via vold
    exec /vendor/bin/hw/vold --blkid-context=u:r:blkid:s0 --blkid-untrusted-context=u:r:blkid_untrusted:s0 --fsck-context=u:r:fsck:s0 --fsck-untrusted-context=u:r:fsck_untrusted:s0 || true

    # Mount metadata untuk FBE (PENTING!)
    wait /dev/block/by-name/metadata
    mount ext4 /dev/block/by-name/metadata /metadata nosuid nodev noatime discard

    # Mount protect partitions
    wait /dev/block/by-name/protect1
    mount ext4 /dev/block/by-name/protect1 /mnt/vendor/protect_f noatime nosuid nodev noauto_da_alloc commit=1 nodelalloc
    wait /dev/block/by-name/protect2
    mount ext4 /dev/block/by-name/protect2 /mnt/vendor/protect_s noatime nosuid nodev noauto_da_alloc commit=1 nodelalloc

on property:ro.crypto.state=encrypted && property:ro.crypto.type=file
    install_keyring

on post-fs
    # Permissions persist untuk mobicore
    chown system system /persist
    chmod 0771 /persist
    mkdir /persist/mcRegistry 0771 system system

    # FIX #3: START BOOT-MTK
    start boot-mtk

    # MTK platform path utils
    exec u:r:update_engine:s0 root root -- /system/bin/mtk_plpath_utils
    start mtk.plpath.utils.link

    chmod 0666 /sys/class/leds/lcd-backlight/brightness
    chmod 0666 /sys/class/backlight/panel0-backlight/brightness

# Symlink preloader setelah mtk_plpath_utils selesai
on property:persist.vendor.mtk.pl_lnk=1
    symlink /dev/block/mapper/pl_a /dev/block/by-name/preloader_raw_a
    symlink /dev/block/mapper/pl_b /dev/block/by-name/preloader_raw_b
    symlink /dev/block/mapper/pl_a /dev/block/platform/bootdevice/by-name/preloader_raw_a
    symlink /dev/block/mapper/pl_b /dev/block/platform/bootdevice/by-name/preloader_raw_b
    symlink /dev/block/by-name/lk1 /dev/block/by-name/bootloader1
    symlink /dev/block/by-name/lk2 /dev/block/by-name/bootloader2

# Fix mmcblk0boot symlinks untuk UFS
on property:vendor.mtk.boot0_linka=1
    symlink /dev/block/sda /dev/block/mmcblk0boot0
on property:vendor.mtk.boot0_linkb=1
    symlink /dev/block/sdb /dev/block/mmcblk0boot0
on property:vendor.mtk.boot0_linkc=1
    symlink /dev/block/sdc /dev/block/mmcblk0boot0
on property:vendor.mtk.boot1_linka=1
    symlink /dev/block/sda /dev/block/mmcblk0boot1
on property:vendor.mtk.boot1_linkb=1
    symlink /dev/block/sdb /dev/block/mmcblk0boot1
on property:vendor.mtk.boot1_linkc=1
    symlink /dev/block/sdc /dev/block/mmcblk0boot1

# FIX #4: Start services HANYA setelah hwservicemanager ready
on property:hwservicemanager.ready=true
    # Start boot-mtk DULU
    start boot-mtk
    # Kemudian start mobicore
    start mobicore
    # Start gatekeeper dan keymint
    start gatekeeper-1-0
    start vendor.keymint-trustonic

# FIX #5: Fallback trigger crypto.ready
on property:crypto.ready=1
    start mobicore
    start vendor.keymint-trustonic

# FIX #6: Stop services setelah decrypt selesai
on property:ro.crypto.state=unsupported
    stop mobicore
    stop gatekeeper-1-0
    stop vendor.keymint-trustonic

on property:ro.crypto.state=unencrypted
    stop mobicore
    stop gatekeeper-1-0
    stop vendor.keymint-trustonic

on property:twrp.decrypt.done=true
    stop mobicore
    stop gatekeeper-1-0
    stop vendor.keymint-trustonic
    start keystore2
    start modules_mount

on property:crypto.ready=0
    stop mobicore
    stop gatekeeper-1-0
    stop vendor.keymint-trustonic

on post-fs-data
    mkdir /data/vendor_de 0770 system system
    mkdir /data/vendor_de/0 0770 system system
    mkdir /data/vendor_de/0/cryptoeng 0770 system system

on boot
    setprop sys.usb.config adb
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "musb-hdrc"
    setprop sys.usb.ffs.aio_compat 1

    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/idVendor 18D1
    write /sys/class/android_usb/android0/idProduct D001
    write /sys/class/android_usb/android0/functions adb
    write /sys/class/android_usb/android0/iManufacturer ${ro.product.manufacturer}
    write /sys/class/android_usb/android0/iProduct ${ro.product.model}
    write /sys/class/android_usb/android0/iSerial ${ro.serialno}
    write /sys/class/android_usb/android0/enable 1

    chmod 0666 /sys/class/leds/lcd-backlight/brightness
    write /sys/class/leds/lcd-backlight/brightness 1024

    mkdir /tp 0777 root root
    mkdir /tp/140956 0777 root root
    copy /vendor/firmware/tp/140956/FW_FT3518_SAMSUNG.img /tp/140956/FW_FT3518_SAMSUNG.img
    copy /vendor/firmware/tp/140956/LIMIT_FT3518_SAMSUNG.img /tp/140956/LIMIT_FT3518_SAMSUNG.img
    chmod 0644 /tp/140956/FW_FT3518_SAMSUNG.img
    chmod 0644 /tp/140956/LIMIT_FT3518_SAMSUNG.img

    start health-hal-2-1
    start vendor.vibrator-default

    # Vibrator permissions
    write /sys/class/leds/vibrator/trigger "transient"
    chown system system /sys/class/leds/vibrator/trigger
    chown system system /sys/class/leds/vibrator/activate
    chown system system /sys/class/leds/vibrator/brightness
    chown system system /sys/class/leds/vibrator/duration
    chown system system /sys/class/leds/vibrator/state

    # Flashlight permissions
    chown system system /sys/class/leds/flashlight/trigger
    chown system system /sys/class/leds/flashlight/brightness
    chown system system /sys/class/leds/flashlight/max_brightness
    chown system system /sys/class/leds/torch-light0/trigger
    chown system system /sys/class/leds/torch-light0/brightness
    chown system system /sys/class/leds/torch-light0/max_brightness

# OTG control
on property:ro.twrp.fastbootd=0
    write /sys/class/oplus_chg/usb/otg_switch "1"
on property:ro.twrp.fastbootd=1
    write /sys/class/oplus_chg/usb/otg_switch "0"

# ============================================================
# SERVICE DEFINITIONS
# ============================================================

# FIX #7: ADB Service dengan definisi yang benar
service adbd /sbin/adbd --root_seclabel=u:r:su:s0
    class core
    user root
    group root
    oneshot
    disabled
    seclabel u:r:recovery:s0

service health-hal-2-1 /vendor/bin/hw/android.hardware.health@2.1-service
    interface android.hardware.health@2.1::IHealth default
    interface android.hardware.health@2.0::IHealth default
    override
    class hal
    user system
    group system
    capabilities WAKE_ALARM BLOCK_SUSPEND
    file /dev/kmsg w
    seclabel u:r:recovery:s0

service gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    interface android.hardware.gatekeeper@1.0::IGatekeeper default
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

service keystore2 /system/bin/keystore2 /tmp/misc/keystore
    class early_hal
    user root
    group root system
    disabled

# FIX #8: vendor.keymint-trustonic dengan oneshot
service vendor.keymint-trustonic /vendor/bin/hw/android.hardware.security.keymint-service.trustonic
    class early_hal
    user root
    group root system
    disabled
    oneshot
    seclabel u:r:recovery:s0

service vendor.vibrator-default /vendor/bin/hw/android.hardware.vibrator-service.mediatek
    class hal
    user root
    group root system
    seclabel u:r:recovery:s0

service tp_fw_flash /system/bin/tp_fw_flash.sh
    user root
    group root
    oneshot
    disabled
    seclabel u:r:recovery:s0

service mtk.plpath.utils.link /system/bin/mtk_plpath_utils
    class main
    user root
    group root system
    disabled
    oneshot
    seclabel u:r:recovery:s0

service modules_mount /system/bin/modules_mount.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

# FIX #9: boot-mtk service dengan oneshot
service boot-mtk /system/bin/android.hardware.boot-service.mtk
    class hal
    user root
    group root system
    disabled
    oneshot
    seclabel u:r:recovery:s0
