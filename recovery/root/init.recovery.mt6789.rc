import /init.recovery.logd.rc

on early-init
    # Set security contexts
    setcon u:r:recovery:s0

    # Start essential services
    start ueventd
    start healthd

on init
    export ANDROID_ROOT /system
    export ANDROID_DATA /data
    export EXTERNAL_STORAGE /sdcard
    
    # Library paths
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/system/lib:/vendor/lib

    # Create mountpoints
    mkdir /boot
    mkdir /recovery
    mkdir /system
    mkdir /vendor
    mkdir /data
    mkdir /metadata
    mkdir /cache
    mkdir /persist
    mkdir /mnt/vendor/persist
    
    # Symlinks for compatibility
    symlink /system/bin /bin
    symlink /system/etc /etc

    # Create device nodes
    mkdir /dev/block
    mkdir /dev/block/platform
    mkdir /dev/block/by-name
    
    # Permissions
    chmod 0666 /dev/null
    chmod 0666 /dev/kmsg
    
on fs
    # Wait for devices
    wait /dev/block/platform/bootdevice
    symlink /dev/block/platform/bootdevice /dev/block/bootdevice
    
    # Mount metadata for FBE
    wait /dev/block/by-name/metadata
    mount ext4 /dev/block/by-name/metadata /metadata nosuid nodev noatime

on post-fs
    # Start keymaster for decryption
    start keystore2
    start gatekeeper-1-0
    start vendor.keymint-default
    
    # Permissions for brightness
    chmod 0666 /sys/class/leds/lcd-backlight/brightness
    chmod 0666 /sys/class/backlight/panel0-backlight/brightness
    
on boot
    # Set USB config
    setprop sys.usb.config adb
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "musb-hdrc"
    setprop sys.usb.ffs.aio_compat 1
    
    # Enable ADB
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/idVendor 18D1
    write /sys/class/android_usb/android0/idProduct D001
    write /sys/class/android_usb/android0/functions adb
    write /sys/class/android_usb/android0/iManufacturer ${ro.product.manufacturer}
    write /sys/class/android_usb/android0/iProduct ${ro.product.model}
    write /sys/class/android_usb/android0/iSerial ${ro.serialno}
    write /sys/class/android_usb/android0/enable 1
    
    # Brightness
    chmod 0666 /sys/class/leds/lcd-backlight/brightness
    write /sys/class/leds/lcd-backlight/brightness 1024

# Healthd service for battery info
service health-hal-2-1 /system/bin/hw/android.hardware.health@2.1-service
    interface android.hardware.health@2.1::IHealth default
    override
    class hal
    user system
    group system
    capabilities WAKE_ALARM BLOCK_SUSPEND
    file /dev/kmsg w
    disabled

# Keymaster 4.1 for decryption
service keymaster-4-1 /vendor/bin/hw/android.hardware.keymaster@4.1-service.trustonic
    interface android.hardware.keymaster@4.0::IKeymasterDevice default
    interface android.hardware.keymaster@4.1::IKeymasterDevice default
    class early_hal
    user system
    group system drmrpc
    disabled

# Gatekeeper for lock screen
service gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    interface android.hardware.gatekeeper@1.0::IGatekeeper default
    class hal
    user system
    group system
    disabled

# Keystore2 for FBE
service keystore2 /system/bin/keystore2 /tmp/misc/keystore
    class early_hal
    user root
    group root system
    disabled

# Vendor KeyMint (for Android 12+)
service vendor.keymint-default /vendor/bin/hw/android.hardware.security.keymint-service.trustonic
    class early_hal
    user nobody
    disabled

on property:twrp.decrypt.done=true
    # Trigger after decryption
    setprop ro.crypto.state encrypted

on property:ro.crypto.state=encrypted
    # Start services needed after decrypt
    start keystore2
